# Copie para .env e ajuste (o docker compose le este arquivo automaticamente).
# TODOS os valores tem padrao no docker-compose.yml: o .env e opcional localmente.

# --- seguranca (TROQUE em qualquer ambiente publico) ---
JWT_SEGREDO=troque-este-segredo-em-producao
JWT_EXPIRA_MIN=30
# contas de demonstracao no formato usuario:senha separadas por virgula
USUARIOS=demo:demo123
TOKEN_INTERNO=token-interno-local
QDRANT_API_KEY=qdrant-chave-local

# --- limites e resiliencia ---
RATE_LIMIT_POR_MINUTO=30
TIMEOUT_INFERENCIA_S=5
TENTATIVAS=3
CB_LIMITE_FALHAS=5
CB_TEMPO_RESET_S=30
MAX_TENTATIVAS=5
VISIBILIDADE_MS=15000

# --- retencao (LGPD) ---
RETENCAO_JOB_S=86400        # status/resultado do job: 24 h
RETENCAO_VETORES_S=604800   # texto + vetor no Qdrant: 7 dias

# --- observabilidade ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
LOG_NIVEL=INFO

# --- injecao de falhas (demonstracao de resiliencia) ---
FALHA_PERCENTUAL=0
LATENCIA_EXTRA_MS=0
